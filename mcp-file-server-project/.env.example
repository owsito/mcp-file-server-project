# Required for HTTP mode. Generate a long random token; never commit a real token.
MCP_AUTH_TOKEN=replace-this-with-a-long-random-token

# HTTP listener. Keep localhost binding for local demo; use a tunnel for HTTPS.
HOST=127.0.0.1
PORT=3000

# Add the host header your HTTPS tunnel uses, e.g. my-subdomain.ngrok-free.app.
# Do not use * for public deployments.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,localhost:3000,127.0.0.1:3000

# Optional: absolute or project-relative path. Default is ./workspace.
# WORKSPACE_ROOT=./workspace
